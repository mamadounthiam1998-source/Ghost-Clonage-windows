<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>GhostClonage</AssemblyName>
    <RootNamespace>Ghost.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ghost.ico</ApplicationIcon>
    <AssemblyTitle>GHOST CLONAGE WINDOWS</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ghost.Core\Ghost.Core.csproj" />
    <ProjectReference Include="..\Ghost.Windows\Ghost.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\ghost.ico" />
    <Resource Include="Assets\ghost.png" />
  </ItemGroup>
</Project>
