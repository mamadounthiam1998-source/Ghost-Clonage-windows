<Window x:Class="Ghost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ghost.App.ViewModels"
        xmlns:v="clr-namespace:Ghost.App.Views"
        Title="GHOST CLONAGE WINDOWS" Width="1120" Height="800" MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgDeepBrush}" Icon="Assets/ghost.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <v:InverseBoolToVisibilityConverter x:Key="NotB2V" />
        <v:ResultKindToBrushConverter x:Key="KindBrush" />
        <v:ResultKindToGlyphConverter x:Key="KindGlyph" />

        <!-- Carte d'information disque -->
        <DataTemplate x:Key="DiskTemplate" DataType="{x:Type vm:DiskItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="30"
                           Foreground="{StaticResource CyanBrush}" VerticalAlignment="Top" Margin="0,2,14,0" />
                <StackPanel Grid.Column="1">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left" />
                        <Border DockPanel.Dock="Right" Background="#33FF4D6D" BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="7,1"
                                Visibility="{Binding IsSystem, Converter={StaticResource B2V}}">
                            <TextBlock Text="SYSTÈME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding Model}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                               Margin="0,1,0,8" TextTrimming="CharacterEllipsis" />
                    <WrapPanel>
                        <StackPanel Width="105" Margin="0,0,0,6">
                            <TextBlock Text="CAPACITÉ" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Capacity}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Width="105" Margin="0,0,0,6">
                            <TextBlock Text="UTILISÉ" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Used}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Width="105" Margin="0,0,0,6">
                            <TextBlock Text="TYPE" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding MediaType}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Width="105">
                            <TextBlock Text="PARTITIONS" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Partitions}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Width="105">
                            <TextBlock Text="TABLE" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Table}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Width="105">
                            <TextBlock Text="INTERFACE" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Bus}" FontWeight="SemiBold" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="DestinationItem" TargetType="ListBoxItem" BasedOn="{StaticResource DiskItem}">
            <Setter Property="IsEnabled" Value="{Binding CanBeDestination}" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fond animé : halos lumineux qui dérivent lentement -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" Canvas.Left="-200" Canvas.Top="-260" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3300E5FF" Offset="0" />
                        <GradientStop Color="#0000E5FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="HaloA" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="820" Height="820" Canvas.Right="-260" Canvas.Bottom="-330" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#332979FF" Offset="0" />
                        <GradientStop Color="#002979FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="HaloB" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barre de titre -->
                <Grid Background="#CC070B12" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Image Source="Assets/ghost.png" Width="20" Height="20" />
                        <TextBlock Text="GHOST CLONAGE WINDOWS" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Réduire" />
                        <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Fermer" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel Margin="36,10,36,24">

                        <!-- En-tête : logo animé + modes -->
                        <Grid Margin="0,6,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/ghost.png" Width="58" Height="58">
                                    <Image.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="22" ShadowDepth="0" Opacity="0.7" />
                                    </Image.Effect>
                                    <Image.RenderTransform>
                                        <TranslateTransform x:Name="GhostFloat" />
                                    </Image.RenderTransform>
                                </Image>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="GHOST CLONAGE WINDOWS" FontSize="28" FontWeight="Bold">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFFFFF" Offset="0" />
                                                <GradientStop Color="#00E5FF" Offset="1" />
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                        <TextBlock.Effect>
                                            <DropShadowEffect x:Name="TitleGlow" Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="Clonage, sauvegarde et restauration de disques Windows" Foreground="{StaticResource MutedBrush}"
                                               FontSize="13" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource ModeButton}" Tag="&#xE8C8;" Content="CLONER"
                                             IsChecked="{Binding IsClone, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" GroupName="mode" />
                                <RadioButton Style="{StaticResource ModeButton}" Tag="&#xE74E;" Content="CRÉER UNE IMAGE"
                                             IsChecked="{Binding IsImage, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" GroupName="mode" />
                                <RadioButton Style="{StaticResource ModeButton}" Tag="&#xE777;" Content="RESTAURER"
                                             IsChecked="{Binding IsRestore, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" GroupName="mode" />
                            </StackPanel>
                        </Grid>

                        <!-- Source -> Destination -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ZONE 1 : SOURCE -->
                            <Border Style="{StaticResource Card}" Height="330">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                                                ToolTip="Actualiser la liste des disques"
                                                Visibility="{Binding ShowSourceDisks, Converter={StaticResource B2V}}">
                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" />
                                        </Button>
                                        <TextBlock Text="{Binding SourceTitle}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <ListBox Grid.Row="1" Style="{StaticResource DiskList}" ItemsSource="{Binding SourceDisks}"
                                             SelectedItem="{Binding SelectedSource, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                             ItemTemplate="{StaticResource DiskTemplate}"
                                             Visibility="{Binding ShowSourceDisks, Converter={StaticResource B2V}}" />

                                    <!-- Restauration : choix de l'image -->
                                    <StackPanel Grid.Row="1" Visibility="{Binding ShowSourceImage, Converter={StaticResource B2V}}">
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Parcourir…"
                                                    Margin="10,0,0,0" Command="{Binding BrowseImageCommand}" />
                                            <TextBox Text="{Binding RestoreImagePath, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsIdle}"
                                                     Background="#0A1220" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}"
                                                     Padding="10,8" CaretBrush="{StaticResource CyanBrush}" FontSize="13" />
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding ImageInfo}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12.5" LineHeight="20" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
                                </TextBlock.Effect>
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="ArrowSlide" />
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <!-- ZONE 2 : DESTINATION -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Height="330">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DestinationTitle}" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource CyanBrush}" Margin="0,0,0,12" VerticalAlignment="Center" />

                                    <ListBox Grid.Row="1" Style="{StaticResource DiskList}" ItemsSource="{Binding DestinationDisks}"
                                             SelectedItem="{Binding SelectedDestination, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                             ItemContainerStyle="{StaticResource DestinationItem}"
                                             ItemTemplate="{StaticResource DiskTemplate}"
                                             Visibility="{Binding ShowDestinationDisks, Converter={StaticResource B2V}}" />

                                    <!-- Image : fichier de sauvegarde -->
                                    <StackPanel Grid.Row="1" Visibility="{Binding ShowDestinationFile, Converter={StaticResource B2V}}">
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Parcourir…"
                                                    Margin="10,0,0,0" Command="{Binding BrowseOutputCommand}" />
                                            <TextBox Text="{Binding OutputImagePath, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsIdle}"
                                                     Background="#0A1220" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}"
                                                     Padding="10,8" CaretBrush="{StaticResource CyanBrush}" FontSize="13" />
                                        </DockPanel>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12.5" LineHeight="20"
                                                   Text="L'image est compressée, vérifiée par SHA-256 puis enregistrée. Elle est écrite dans un fichier temporaire et n'est reconnue comme sauvegarde valide qu'une fois entièrement vérifiée. Choisissez un autre disque que celui à sauvegarder." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding DiskStatus}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,8,0,0"
                                   Visibility="{Binding IsIdle, Converter={StaticResource B2V}}" />

                        <!-- ZONE 3 : BOUTON PRINCIPAL -->
                        <Grid Margin="0,18,0,0" Height="64">
                            <Button Style="{StaticResource BigButton}" Content="{Binding ActionLabel}" Command="{Binding StartCommand}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource B2V}}" />
                            <Button Style="{StaticResource DangerButton}" Content="ANNULER L'OPÉRATION" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource B2V}}" />
                        </Grid>

                        <!-- Progression -->
                        <Border Style="{StaticResource Card}" Margin="0,18,0,0"
                                Visibility="{Binding ShowProgress, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,2,0,12" />
                                <ProgressBar Style="{StaticResource GhostProgress}" Value="{Binding Percent}" />
                                <UniformGrid Columns="4" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="DONNÉES TRAITÉES" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding BytesText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="VITESSE" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding SpeedText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="TEMPS ÉCOULÉ" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding ElapsedText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="TEMPS RESTANT" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding RemainingText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Résultat : jamais « terminé » si une vérification a échoué -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                                BorderBrush="{Binding ResultKind, Converter={StaticResource KindBrush}}"
                                Visibility="{Binding HasResult, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ResultKind, Converter={StaticResource KindGlyph}}"
                                               FontFamily="{StaticResource IconFont}" FontSize="22"
                                               Foreground="{Binding ResultKind, Converter={StaticResource KindBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ResultTitle}" FontSize="18" FontWeight="Bold" Margin="12,0,0,0"
                                               Foreground="{Binding ResultKind, Converter={StaticResource KindBrush}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13.5" />
                                <TextBlock Text="{Binding ResultWarnings}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12.5"
                                           Foreground="{StaticResource WarnBrush}"
                                           Visibility="{Binding HasWarnings, Converter={StaticResource B2V}}" />
                                <TextBlock Text="{Binding LogPath, StringFormat='Journal : {0}'}" Margin="0,10,0,0" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                   Text="Aucune donnée n'est collectée ni envoyée : pas de télémétrie, pas de connexion Internet, pas de compte." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="HaloA" Storyboard.TargetProperty="X" From="0" To="220" Duration="0:0:14">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="HaloA" Storyboard.TargetProperty="Y" From="0" To="140" Duration="0:0:11">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="HaloB" Storyboard.TargetProperty="X" From="0" To="-240" Duration="0:0:16">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="HaloB" Storyboard.TargetProperty="Y" From="0" To="-120" Duration="0:0:12">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="GhostFloat" Storyboard.TargetProperty="Y" From="-4" To="4" Duration="0:0:2.4">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="TitleGlow" Storyboard.TargetProperty="Opacity" From="0.3" To="0.8" Duration="0:0:2.8" />
                    <DoubleAnimation Storyboard.TargetName="ArrowSlide" Storyboard.TargetProperty="X" From="-5" To="5" Duration="0:0:1.1">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
