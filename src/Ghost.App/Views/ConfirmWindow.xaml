<Window x:Class="Ghost.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmation" Width="620" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Background="{StaticResource BgPanelBrush}" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="30"
                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Margin="14,0,0,0" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="HeadlineText" Grid.Row="1" Margin="0,18,0,0" TextWrapping="Wrap" FontSize="15"
                       FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />

            <Border Grid.Row="2" Margin="0,14,0,0" Background="#1A0F16" BorderBrush="#5A2433" BorderThickness="1"
                    CornerRadius="10" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="DISQUE CONCERNÉ" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="TargetText" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                <ItemsControl x:Name="DetailsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <CheckBox x:Name="UnderstandBox" Grid.Row="4" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}"
                      FontFamily="{StaticResource UiFont}" FontSize="13.5"
                      Content="Je comprends que ces données seront définitivement perdues et j'ai vérifié que c'est le bon disque."
                      Checked="OnCheckChanged" Unchecked="OnCheckChanged">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </CheckBox.LayoutTransform>
            </CheckBox>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelBtn" Content="Annuler" Style="{StaticResource GhostButton}" Width="130" Height="44"
                        IsCancel="True" IsDefault="True" Click="OnCancel" />
                <Button x:Name="ConfirmBtn" Style="{StaticResource DangerButton}" Margin="12,0,0,0" Height="44" MinWidth="230"
                        FontSize="14" IsEnabled="False" Click="OnConfirm" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
